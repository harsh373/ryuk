<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.ryuk" path="/org/gnome/shell/extensions/ryuk/">
    <key name="visible" type="b"><default>true</default><summary>Show Ryuk</summary></key>
    <key name="paused" type="b"><default>false</default><summary>Pause movement</summary></key>
    <key name="speed" type="d"><range min="0.25" max="3.0"/><default>1.0</default><summary>Movement speed multiplier</summary></key>
    <key name="activity" type="d"><range min="0.0" max="3.0"/><default>1.0</default><summary>How often special behaviours happen</summary></key>
    <key name="size" type="d"><range min="0.5" max="2.0"/><default>1.0</default><summary>Sprite scale</summary></key>
    <key name="climbing" type="b"><default>true</default><summary>Allow climbing walls and the ceiling</summary></key>
    <key name="jumping" type="b"><default>true</default><summary>Allow jumping</summary></key>
    <key name="draggable" type="b"><default>true</default><summary>Allow dragging him with the mouse</summary></key>
    <key name="show-over-fullscreen" type="b"><default>false</default><summary>Show Ryuk over fullscreen windows</summary><description>When on, Ryuk stays visible while a window is fullscreen. When off, he hides until fullscreen ends.</description></key>
    <key name="launch-at-login" type="b"><default>true</default><summary>Keep running across logins</summary></key>
  </schema>
</schemalist>